# kustomize secretGenerator 견본(D-121) — `cp secret.env.example secret.env` 뒤 채운다. secret.env는 커밋하지 않는다(.gitignore).
# 한 줄에 `이름=값`, 따옴표·줄 끝 주석 없이(둘 다 값이 된다). 키 두 개는 `python -m gateway keygen`으로 만든다.
# 결정적 대체값 키(32자 이상). 원문을 되짚을 수 있는 키라 공급자 키와 같은 등급으로 다룬다. 바꾸는 절차는 docs/operations.md '키 회전'.
GATEWAY_SURROGATE_KEY=
# /__gateway/의 info·metrics·stats·대시보드를 여는 관리 키(Authorization: Bearer, 대시보드는 화면에 키를 넣는다). 비우면 모두 404.
GATEWAY_ADMIN_KEY=
# 공급자 키 — gateway.toml의 key_env 이름과 같아야 한다.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
