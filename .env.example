# .env 견본 — `cp .env.example .env` 뒤 값을 채운다. .env는 커밋하지 않는다(.gitignore).
# docker compose, eval/*.py, scripts/*.sh가 이 파일 하나를 단일 출처로 읽는다.

# AnythingLLM(타겟 앱) — eval/·garak 스크립트가 쓴다. 키는 AnythingLLM 설정 > API Keys에서 만든다.
TARGET_URL=http://localhost:8000
TARGET_API_KEY=
WORKSPACE_SLUG=

# 카나리 3종(EVAL 2.3, D-058) — eval/setup_target.py가 타겟에 심고, canary_observe가 관측한다.
# 실행마다 새로 만든다(하드코딩 금지). 'CANARY'·'SECRET' 같은 보안 관례 접두사를 쓰지 않는다.
# canary_observe를 켜지 않으면 비워 둬도 게이트웨이는 뜬다. 켰는데 비어 있으면 기동을 거부한다.
CANARY_A_TOKEN=
CANARY_B_TOKEN=
DOC_CANARY_TOKEN=

# 선택 — 새 구조(AnythingLLM → 게이트웨이 /v1 → Ollama)로 돌릴 때만(README 6절, D-081).
# ANYTHINGLLM_LLM_PROVIDER=generic-openai
# GATEWAY_TARGET_URL=http://host.docker.internal:11434
# GATEWAY_DETECTORS=injection_rule_turn,pii_mask
