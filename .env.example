# .env 견본 — `cp .env.example .env` 뒤 값을 채운다. .env는 커밋하지 않는다(.gitignore).
# 게이트웨이는 .env를 스스로 읽지 않는다 — `uvicorn gateway.main:app --env-file .env`로 넘긴다.
# 전체 설정은 README '설정' 절에 있다.

# 상류(공급자) 주소 — 예: https://api.openai.com, https://api.anthropic.com
TARGET_URL=http://localhost:8000
# 클라이언트 키 `이름=키,…` — 필수. `python -m gateway keygen`으로 만든다.
GATEWAY_CLIENT_KEYS=
# 결정적 대체값 키(32자 이상) — PII mask 모드(기본)면 필수. `python -m gateway keygen`으로 만든다. 공급자 키와 같은 등급으로 보관한다.
GATEWAY_SURROGATE_KEY=
# 공급자 키 — 게이트웨이 한 곳에만 둔다. 비우면 클라이언트의 인증 헤더를 그대로 넘긴다.
GATEWAY_UPSTREAM_KEY=
# 관리 키 — /__gateway/info·/__gateway/metrics를 연다(Authorization: Bearer). 비우면 둘 다 404.
GATEWAY_ADMIN_KEY=
